<Window x:Class="MyApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid x:Name="Main_Grid">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Width" Value="150" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="10,20"/>
            </Style>
        </Grid.Resources>
        <Image x:Name="LoadedImage" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="40" Stretch="None"/>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Label Grid.Column="1" x:Name="LabelResult" />
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Click="OnClick_LoadImage" Content="Load Image" />
            <Button Click="OnClick_RunAsm2" Content="Run Asm2" />
        </StackPanel>
    </Grid>
</Window>
