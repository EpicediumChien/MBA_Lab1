<Window x:Class="MyImageCompareApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyImageCompareApp"
        mc:Ignorable="d"
        Title="MainWindow" MinWidth="1200" 
        SizeToContent="Width">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Width" Value="150" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="10,20"/>
            </Style>
            <Style TargetType="Image">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="40" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="MaxWidth" Value="600" />
            </Style>
        </Grid.Resources>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Image x:Name="LoadedImage"/>
            <Image x:Name="LoadedReference"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Image x:Name="LoadedMark" MaxWidth="300" MaxHeight="300"/>
            <Button Click="OnClick_LoadMark" Content="Load Mark" />
            <Button Click="OnClick_LoadReference" Content="Load Ref" />
            <Button Click="OnClick_LoadImage" Content="Load Image" />
            <Button Click="OnClick_MarkOnReference" Content="Mark Reference" />
            <Button Click="OnClick_RunCompare" Content="Run Compare" />
            <!--<Button Click="OnClick_ChainCode" Content="Chain code" />-->
        </StackPanel>
    </Grid>
</Window>
