<Window x:Class="MyImageCompareApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyImageCompareApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Width" Value="150" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="10,20"/>
            </Style>
        </Grid.Resources>
        <StackPanel >
            <Image x:Name="LoadedImage1" VerticalAlignment="Top" Margin="40" Stretch="None"/>
            <Image x:Name="LoadedImage2" VerticalAlignment="Top" Margin="40" Stretch="None"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Label Grid.Column="1" x:Name="LabelResult" />
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button Click="OnClick_LoadImage" Content="Load Image" />
            <Button Click="OnClick_RunCompare" Content="Run Compare" />
            <!--<Button Click="OnClick_ChainCode" Content="Chain code" />-->
        </StackPanel>
    </Grid>
</Window>
